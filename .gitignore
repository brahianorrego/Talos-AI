# Repositorio PÚBLICO: nada de IPs, usuarios, claves, WiFi, fotos de personas, Word ni PDFs del comité.

# --- Secretos ---
.env
.env.*
*.env
*.key
*.pem
id_rsa*
id_ed25519*

# --- Privado: documento, memoria de Claude, permisos locales y registros de la migración ---
07_DOCUMENTO_PROYECTO_DE_GRADO/
_memoria_claude/
.claude/settings.local.json
_copia_log.txt

# --- Fotos con personas o de origen desconocido (quedan solo en el PC) ---
08_EVIDENCIA_Y_DIAGRAMAS/paneles_de_exposicion_universidad.png
08_EVIDENCIA_Y_DIAGRAMAS/pan_tilt_servos.png
08_EVIDENCIA_Y_DIAGRAMAS/privado/

