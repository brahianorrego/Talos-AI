datos_campo/
registros/
01_MINIMO_INDISPENSABLE/registros_campo/*
!01_MINIMO_INDISPENSABLE/registros_campo/.gitkeep

# --- Entornos virtuales y cachés ---
.venv/
venv/
env/
__pycache__/
*.pyc

# --- Modelos y tensores (pesan GB; van a una Release de GitHub o a Google Drive) ---
*.zip
*.pt
*.pth
*.npy
*.npz
*.engine
*.onnx
03_SIMULACION_RL/modelos_master/
03_SIMULACION_RL/modelos_v*/
_archivo_versiones/modelos_y_salidas/

# --- Salidas pesadas, logs y TensorBoard ---
salida*/
*.log
runs/
tb_logs/
tensorboard/
events.out.tfevents.*

# --- Sistema ---
.DS_Store
Thumbs.db
desktop.ini

